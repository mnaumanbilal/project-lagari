# Server
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# PostgreSQL — REQUIRED: set your real postgres installation password
# Quick setup: npm run setup:env
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
# pern-alpha naming also supported:
# DB_USERNAME=postgres
DB_PASSWORD=
DB_NAME=lagari
DB_LOGGING=false

# Alternative: single connection string (overrides DB_* above in app + Sequelize CLI)
# DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@127.0.0.1:5432/lagari

# Redis (optional — in-memory cart fallback if unset)
REDIS_URL=

# JWT (change in production)
JWT_ACCESS_SECRET=dev-lagari-access-secret-min-32-chars-long
JWT_REFRESH_SECRET=dev-lagari-refresh-secret-min-32-chars-long
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Seed admin (development)
SEED_ADMIN_EMAIL=admin@lagari.pk
SEED_ADMIN_PASSWORD=changeme123

# Cloudinary (optional — admin upload + CDN transforms; paste URLs still works without)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=lagari/products

# Gmail SMTP (admin notification emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_APP_PASSWORD=
EMAIL_FROM=Lagari <you@gmail.com>
ADMIN_EMAIL=

# Slack (optional)
SLACK_WEBHOOK_URL=

# Storefront URL (local dev — CORS only, not used in customer emails)
STOREFRONT_URL=http://localhost:3000

# Public site URL (lagari.pk link in customer emails)
PUBLIC_SITE_URL=https://www.lagari.pk

# Primary domain for admin panel links in notification emails
DOMAIN=https://www.lagari.pk

# WhatsApp (customer email footer)
WHATSAPP_PHONE=+92 321 0911174
WHATSAPP_URL=https://wa.me/923210911174

# Web Push — disabled for now
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@gmail.com
