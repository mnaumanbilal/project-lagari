# Server
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# PostgreSQL — REQUIRED: set your real postgres installation password
# Quick setup: npm run setup:env
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
# pern-alpha naming also supported:
# DB_USERNAME=postgres
DB_PASSWORD=
DB_NAME=lagari
DB_LOGGING=false

# Alternative: single connection string (overrides DB_* above in app + Sequelize CLI)
# DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@127.0.0.1:5432/lagari

# Redis (optional — in-memory cart fallback if unset)
REDIS_URL=

# JWT (change in production)
JWT_ACCESS_SECRET=dev-lagari-access-secret-min-32-chars-long
JWT_REFRESH_SECRET=dev-lagari-refresh-secret-min-32-chars-long
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Seed admin (development)
SEED_ADMIN_EMAIL=admin@lagari.pk
SEED_ADMIN_PASSWORD=changeme123

# Cloudinary (optional — admin upload + CDN transforms; paste URLs still works without)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=lagari/products
